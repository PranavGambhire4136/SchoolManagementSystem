@model SchoolManagementSystem.Models.ViewModel.RemoveSubjectViewModel

@{
    ViewData["Title"] = "Remove Subject";
}

<div class="container mt-4">
    <div class="card">

        <div class="card-header">
            <h3>Remove Subject From Class</h3>
        </div>

        <div class="card-body">

            <!-- Select Class -->
            <form asp-controller="Subject"
                  asp-action="RemoveSubject"
                  method="get">

                <div class="mb-3">
                    <label class="form-label">Select Class</label>

                    <select name="ClassId"
                            class="form-select"
                            onchange="this.form.submit()">

                        <option value="0">
                            -- Select Class --
                        </option>

                        @foreach (var item in Model.Classes)
                        {
                            <option value="@item.Id"
                                    selected="@(Model.ClassId == item.Id)">
                                Class @item.Standard
                            </option>
                        }

                    </select>
                </div>

            </form>


            @if (Model.ClassId != 0)
            {
                @if (Model.Subjects.Any())
                {
                    <!-- Select Subject -->
                    <form asp-controller="Subject"
                          asp-action="RemoveSubject"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="ClassId"
                               value="@Model.ClassId" />

                        <div class="mb-3">
                            <label class="form-label">
                                Select Subject
                            </label>

                            <select name="SubjectId"
                                    class="form-select"
                                    required>

                                <option value="0">
                                    -- Select Subject --
                                </option>

                                @foreach (var subject in Model.Subjects)
                                {
                                    <option value="@subject.Id">
                                        @subject.Name
                                    </option>
                                }

                            </select>
                        </div>

                        <button type="submit"
                                class="btn btn-danger">
                            Remove Subject
                        </button>

                    </form>
                }
                else
                {
                    <div class="alert alert-info">
                        No subjects are assigned to this class.
                    </div>
                }
            }

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}