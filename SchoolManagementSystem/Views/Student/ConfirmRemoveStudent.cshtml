@model SchoolManagementSystem.Models.Student

@{
    ViewData["Title"] = "Confirm Delete";
}

<div class="container mt-5">

    <div class="card">

        <div class="card-header bg-danger text-white">
            <h3>Confirm Student Deletion</h3>
        </div>

        <div class="card-body">

            <h5>Are you sure you want to delete this student?</h5>

            <hr />

            <p>
                <strong>Name:</strong>
                @Model.User?.Name
            </p>

            <p>
                <strong>Email:</strong>
                @Model.User?.Email
            </p>

            <p>
                <strong>Roll No:</strong>
                @Model.RollNo
            </p>

            <p>
                <strong>Class:</strong>
                @Model.Class?.Standard
            </p>

            <div class="mt-4">

                <form asp-action="DeleteStudent"
                      method="post"
                      style="display:inline;">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-danger">

                        Yes, Delete Student

                    </button>

                </form>

                <a asp-action="RemoveStudent"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </div>

        </div>

    </div>

</div>