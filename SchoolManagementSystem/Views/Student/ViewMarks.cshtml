@model List<SchoolManagementSystem.Models.Marks>

@{
    ViewData["Title"] = "My Marks";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">My Marks</h2>
            <p class="text-muted mb-0">
                View your subject-wise examination marks
            </p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No marks have been assigned yet.
        </div>
    }
    else
    {
        <!-- Student Information -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="row">

                    <div class="col-md-4">
                        <small class="text-muted">Student Name</small>
                        <h5 class="fw-bold">
                            @Model.First().Student.User.Name
                        </h5>
                    </div>

                    <div class="col-md-4">
                        <small class="text-muted">Roll Number</small>
                        <h5 class="fw-bold">
                            @Model.First().Student.RollNo
                        </h5>
                    </div>

                    <div class="col-md-4">
                        <small class="text-muted">Class</small>
                        <h5 class="fw-bold">
                            @Model.First().Student.ClassId
                        </h5>
                    </div>

                </div>
            </div>
        </div>

        <!-- Marks Table -->
        <div class="card shadow-sm border-0">

            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Subject-wise Marks</h5>
            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover mb-0 align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Subject</th>
                                <th>Marks Obtained</th>
                                <th>Maximum Marks</th>
                                <th>Percentage</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var mark in Model)
                            {
                                var percentage =
                                mark.MaxMarks > 0
                                ? (mark.MarksObtained * 100.0 / mark.MaxMarks)
                                : 0;

                                <tr>

                                    <td>
                                        @count
                                    </td>

                                    <td>
                                        <strong>
                                            @mark.Subject?.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @mark.MarksObtained
                                    </td>

                                    <td>
                                        @mark.MaxMarks
                                    </td>

                                    <td>
                                        @percentage.ToString("0.##")%
                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>

        <!-- Overall Summary -->
        <div class="row mt-4">

            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">
                        <small class="text-muted">Subjects</small>
                        <h3 class="fw-bold">
                            @Model.Count
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">
                        <small class="text-muted">Total Marks</small>
                        <h3 class="fw-bold">
                            @Model.Sum(m => m.MarksObtained)
                            /
                            @Model.Sum(m => m.MaxMarks)
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center">
                        <small class="text-muted">Overall Percentage</small>

                        @{
                            var totalMaxMarks = Model.Sum(m => m.MaxMarks);
                            var totalObtainedMarks = Model.Sum(m => m.MarksObtained);

                            var overallPercentage =
                            totalMaxMarks > 0
                            ? totalObtainedMarks * 100.0 / totalMaxMarks
                            : 0;
                        }

                        <h3 class="fw-bold">
                            @overallPercentage.ToString("0.##")%
                        </h3>

                    </div>
                </div>
            </div>

        </div>
    }
</div>